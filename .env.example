# AppsFlyer OneLink base URL. Each job page adds pid, c, af_sub1, and af_sub2.
# Example: https://hetal.onelink.me/AbCd
# Until the client sends the real link, the placeholder below is used.
ONELINK_BASE_URL=https://hetal.onelink.me/placeholder

# Public origin for canonical URLs and JobPosting JSON-LD.
SITE_URL=https://jobs.hetalretail.com
